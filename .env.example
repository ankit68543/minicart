# OpenTelemetry Configuration
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# Service Configuration
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:5001

# Service Names
SERVICE_NAME=catalog-service
SERVICE_VERSION=1.0.0

# Service URLs (for inter-service communication)
CATALOG_SERVICE_URL=http://catalog-service:5001
CART_SERVICE_URL=http://cart-service:5002
ORDER_SERVICE_URL=http://order-service:5003
WEB_SERVICE_URL=http://web:3000

# Prometheus Configuration
PROMETHEUS_SCRAPE_INTERVAL=15s

# Loki Configuration
LOKI_URL=http://loki:3100

# Tempo Configuration
TEMPO_ENDPOINT=http://tempo:3200

# Grafana Configuration
GF_SECURITY_ADMIN_PASSWORD=admin
GF_SECURITY_ADMIN_USER=admin
GF_INSTALL_PLUGINS=
GF_PATHS_PROVISIONING=/etc/grafana/provisioning

# Docker Compose
COMPOSE_PROJECT_NAME=minicart
COMPOSE_FILE=docker-compose.yml
